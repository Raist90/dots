// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
    }
  },
  {
    "context": "(ProjectPanel && not_editing) || (vim_mode == normal && vim_operator == none && !VimWaiting)",
    "bindings": {
      "space e": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": ["project_panel::Delete", { "skip_prompt": false}],
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "x": "project_panel::Cut",
      "z": "project_panel::CollapseAllEntries"
    }
  },
  {
    "context": "Terminal || ProjectPanel && not_editing || (vim_mode == normal && vim_operator == none && !VimWaiting)",
    "bindings": {
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "space w w": "workspace::ActivateNextPane"
    }
  },
  {
    "context": "Editor && vim_mode == normal && vim_operator == none && !VimWaiting",
    "bindings": {
      "space c": [
        "pane::CloseActiveItem",
        {
          "save_intent": "close"
        }
      ],
      "space b c": "pane::CloseInactiveItems",
      "space l r": "editor::Rename",
      "space b p": "pane::TogglePinTab",
      "space f f": "file_finder::Toggle",
      "s": "vim::Search",
      "space w v": "pane::SplitRight",
      "space f b": "tab_switcher::Toggle",
      "space f w": "pane::DeploySearch",
      "space t r": ["task::Spawn", { "task_name": "Run Vitest" }],
      "space Z": "workspace::ToggleCenteredLayout"
    }
  },
  {
    "context": "Editor && vim_mode == normal || vim_mode == visual && vim_operator == none && !VimWaiting",
    "bindings": {
      "space  l  a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "Editor && vim_mode == insert && vim_operator == none && !VimWaiting",
    "bindings": {
      "ctrl-x": "editor::ShowCompletions"
    }
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions) && !Terminal",
    "bindings": {
      "shift-tab": "editor::ContextMenuPrevious",
      "tab": "editor::ContextMenuNext"
    }
  },
  {
    "context": "Workspace && !Terminal",
    "bindings": {
      "cmd-n": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-n": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "VimControl",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }]
    }
  },
  {
    "context": "VimCount",
    "bindings": {
      "j": ["vim::Down", { "display_lines": false }],
      "k": ["vim::Up", { "display_lines": false }]
    }
  }
]
