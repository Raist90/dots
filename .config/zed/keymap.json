// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == normal && vim_operator == none && !VimWaiting",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "space c": [
        "pane::CloseActiveItem",
        {
          "saveIntent": "skip"
        }
      ],
      "space b c": "pane::CloseInactiveItems",
      "space l r": "editor::Rename",
      "space b p": "pane::TogglePinTab",
      "space f f": "file_finder::Toggle",
      "s": "vim::Search",
      "space w v": "pane::SplitRight",
      "space f b": "tab_switcher::Toggle",
      "space t r": ["task::Spawn", { "task_name": "Run Vitest" }]
    }
  },
  {
    "context": "Editor && vim_mode == normal || vim_mode == visual && vim_operator == none && !VimWaiting",
    "bindings": {
      "space  l  a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "Editor && vim_mode == insert && vim_operator == none && !VimWaiting",
    "bindings": {
      "ctrl-x": "editor::ShowCompletions"
    }
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "shift-tab": "editor::ContextMenuPrev",
      "tab": "editor::ContextMenuNext"
    }
  }
]
